<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Packages">
            <directory>packages/address/tests</directory>
            <directory>packages/admin/tests</directory>
            <directory>packages/article-parser/tests</directory>
            <directory>packages/article-scraper/tests</directory>
            <directory>packages/cms/tests</directory>
            <directory>packages/cms-post-generator/tests</directory>
            <directory>packages/cms-post-relations/tests</directory>
            <directory>packages/cms-search/tests</directory>
            <directory>packages/contact/tests</directory>
            <directory>packages/currency/tests</directory>
            <directory>packages/customer/tests</directory>
            <directory>packages/gallery/tests</directory>
            <directory>packages/html-parser/tests</directory>
            <directory>packages/language/tests</directory>
            <directory>packages/media/tests</directory>
            <directory>packages/menu/tests</directory>
            <directory>packages/order/tests</directory>
            <directory>packages/post-calendar/tests</directory>
            <directory>packages/product/tests</directory>
            <directory>packages/purchase/tests</directory>
            <directory>packages/rss-watcher/tests</directory>
            <directory>packages/setting/tests</directory>
            <directory>packages/shop/tests</directory>
            <directory>packages/stock/tests</directory>
            <directory>packages/theme/tests</directory>
            <directory>packages/unas/tests</directory>
            <directory>packages/user/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
