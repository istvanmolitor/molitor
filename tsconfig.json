{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"],
      "@admin/*": ["resources/js/packages/vue-admin/*"],
      "@article-scraper/*": ["resources/js/packages/vue-article-scraper/*"],
      "@cms/*": ["resources/js/packages/vue-cms/*"],
      "@currency/*": ["resources/js/packages/vue-currency/*"],
      "@media/*": ["resources/js/packages/vue-media/*"],
      "@menu/*": ["resources/js/packages/ts-menu/*"],
      "@product/*": ["resources/js/packages/vue-product/*"],
      "@rss-watcher/*": ["resources/js/packages/vue-rss-watcher/*"],
      "@theme/*": ["resources/js/packages/vue-theme/*"],
      "@user/*": ["resources/js/packages/vue-user/*"],
      "@language/*": ["resources/js/packages/vue-language/*"]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.d.ts",
    "resources/js/**/*.tsx",
    "resources/js/**/*.vue"
  ],
  "exclude": ["node_modules"],
  "references": [{ "path": "./tsconfig.node.json" }]
}


